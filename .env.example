# SMTP sender credentials. Copy to .env locally and keep real secrets out of Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Constructora Example <your-account@example.com>

# Destination inbox that receives contact form messages.
CONTACT_EMAIL=contact@example.com
