
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constructoraherrera-landingpage",
  "main": "./src/worker.ts",
  "keep_vars": true,
  "compatibility_date": "2026-11-17",
  "vars": {
    "CONTACT_EMAIL": "joeltroncoso2002@gmail.com",
    "RESEND_FROM": "Constructora Herrera <onboarding@resend.dev>"
  },
  "secrets": {
    "required": ["RESEND_API_KEY"]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/constructoralp/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
